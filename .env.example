# Токен бота из Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Публичный адрес, по которому пользователи будут открывать галерею (без слэша в конце)
PUBLIC_BASE_URL=https://sub.domain.duckdns.org

# Адрес и порт внутреннего веб-сервера (для Nginx Reverse Proxy)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Локальный прокси для доступа к Discord и X через VPN (оставьте пустым, если не нужен)
PROXY_URL=socks5://127.0.0.1:1080

# Директория хранения оригиналов и временная папка для сжатия видео
DATA_DIR=./data
TEMP_DIR=/tmp/xbot_compress

# Минимальный остаток свободного места на диске контейнера (в гигабайтах)
MIN_FREE_SPACE_GB=5.0

# Параметры обработки видео и предпросмотров
VIDEO_CODEC=libx265
PREVIEW_FORMAT=webp
PREVIEW_QUALITY=90
MAX_CONCURRENT_JOBS=2

# Поведение в чате Discord
DELETE_ORIGINAL_MESSAGE=true
ADD_DELETE_REACTION=true
DELETE_FILES_ON_RETRACT=true