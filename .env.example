# Discord bot token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Public URL where users will open the web gallery (no trailing slash)
PUBLIC_BASE_URL=https://sub.domain.duckdns.org

# Internal web server bind address and port (for Nginx Reverse Proxy)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Local proxy for Discord and X traffic via VPN (leave empty if not needed)
PROXY_URL=socks5://127.0.0.1:1080

# Directories for permanent originals and temporary compression files
DATA_DIR=./data
TEMP_DIR=/tmp/xbot_compress

# Disk & resource limits
# Minimum free disk space (GB) before FIFO cleanup deletes oldest posts
MIN_FREE_SPACE_GB=5.0
# Minimum free RAM (MB) required before starting a new heavy job
MIN_FREE_RAM_MB=512
# Maximum number of parallel jobs across different channels/servers
MAX_CONCURRENT_JOBS=2

# Message filtering
# Ignore user messages if text length (excluding all URLs) exceeds this limit
MAX_COMMENT_LENGTH=50

# Web gallery default view mode: carousel | comic | masonry | grid
DEFAULT_VIEW_MODE=carousel

# Media processing & modern codecs (avoid H.264)
# Supported video codecs: libsvtav1, libvpx-vp9, libx265
VIDEO_CODEC=libsvtav1
# Compression speed/quality preset (defaults to a slow, high-quality mode):
#   libsvtav1 : 0 (slowest/best) .. 13 (fastest) -> recommended: 4
#   libx265   : veryslow, slower, slow, medium, fast -> recommended: slower
#   libvpx-vp9: 0 (slowest/best) .. 5 (fastest) -> recommended: 1
VIDEO_PRESET=4

# Preview image settings for fast web gallery loading (avoid JPEG banding)
PREVIEW_FORMAT=webp
PREVIEW_QUALITY=90

# Discord chat behavior
DELETE_ORIGINAL_MESSAGE=true
ADD_DELETE_REACTION=true
ADD_LIKE_REACTION=true
DELETE_FILES_ON_RETRACT=true